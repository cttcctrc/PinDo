      {"from": "idle_sit", "to": "sit_to_stand", "probability": 0.65, "guard": "one_check_per_sit_session && no_modal && no_pending_high_priority_event"}
    ],
    "idle.doze_timeout": [{"from": "doze_loop", "to": "doze_to_sleep", "guard": "no_upcoming_reminder && !pointer_down"}],
    "wake": [{"from": "doze_loop", "to": "doze_to_stand"}, {"from": "sleep_loop", "to": "sleep_to_stand"}],
    "drag.start": [
      {"from": "idle_stand", "to": "stand_to_drag"},
      {"from": "idle_sit", "to": "sit_to_drag"},
      {"from": "doze_loop", "to": "doze_to_drag"},
      {"from": "sleep_loop", "to": "sleep_to_drag"},
      {"from": "disappointed", "to": "disappointed_to_drag", "request_safe_entry_frame": 19},
      {"from": "melt_loop", "to": "melt_to_drag", "at_safe_exit_frame": 0}
    ],
    "drag.release": [{"from": "drag_hold", "to": "drag_release_to_fall"}],
    "physics.airborne": [{"from": "drag_release_to_fall", "to": "fall_loop"}],
    "physics.ground_contact": [{"from": "fall_loop", "to": "fall_to_stand", "at_safe_exit_frame": 0}],
    "emotion.disappointed": [{"from": "idle_stand", "to": "disappointed", "guard": "now >= disappointed_cooldown_until"}],
    "emotion.melt_branch": [{"from": "disappointed", "to": "disappointed_to_melt", "at_frame": 19, "guard": "payload.melt == true || payload.severity == 'high'"}],
    "emotion.recover": [{"from": "melt_loop", "to": "melt_to_stand", "at_safe_exit_frame": 0}]
  },
  "priority_high_to_low": ["app_visibility", "drag", "fall_and_landing", "explicit_wake_or_reminder", "emotion", "sleep", "doze", "sit", "stand_idle"],
